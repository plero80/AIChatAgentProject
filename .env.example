# Copy to .env and fill in. Values below are the defaults used when unset.

# --- Required ---
OPENAI_API_KEY=
POSTGRES_PASSWORD=

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipes_db
DB_USER=postgres
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- Models ---
CHAT_MODEL=gpt-5.4-mini
CHAT_MAX_TOKENS=16000
EMBEDDING_MODEL=text-embedding-3-small

# --- API ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# --- Rate limits (requests per minute) ---
RATE_LIMIT_PER_USER=15
RATE_LIMIT_PER_IP=40

# --- Logging ---
LOG_LEVEL=INFO

# Set true when serving over HTTPS so the session cookie is never sent on HTTP
SESSION_COOKIE_SECURE=false
