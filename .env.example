# Copy to .env and fill in. Values below are the defaults used when unset.

# --- Deployment identity ---
# file preserves the existing deployment; database enables /c/{slug} and published releases.
# Prepare/import the catalog first: docs/iterations/09_CLIENT_RELEASES_AND_BINDINGS.md
CLIENT_CONFIG_SOURCE=file
# The settings below select the legacy file deployment and offline export/ingestion.
# Database HTTP routing resolves client IDs from URL slugs instead.
# clinic_001 = Alona; clinic_002 = Dana demo (no recipes/contact form).
# Required explicitly on Railway in file mode. File changes take effect on restart.
DIETITIAN_ID=clinic_001

# --- Required ---
# OpenAI is required for embeddings. Add another key if switching chat providers.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
POSTGRES_PASSWORD=

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipes_db
DB_USER=postgres
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- Models ---
# Database mode reads model profiles from each immutable release, not these settings.
# These settings configure the implicit "default" chat profile.
# Explicit profiles in config/models.json have their own provider, model and settings.
CHAT_MODEL=gpt-5.4-mini
CHAT_MAX_TOKENS=16000
# OpenAI only. Set empty to omit this option for models that do not support it.
OPENAI_REASONING_EFFORT=none
EMBEDDING_MODEL=text-embedding-3-small

# --- Model profiles and assignments ---
# config/models.json uses the implicit default profile unless you add named profiles.
# config/models.example.json shows separate classifier and writer profiles.
# Precedence for assignments: CLI --model > environment > JSON > "default".
# MODELS_CONFIG=config/models.json
# MESSAGE_ANALYZER_MODEL_PROFILE=default
# RECIPE_GENERATION_MODEL_PROFILE=default
# RECIPE_EXTRACTOR_MODEL_PROFILE=default
# CHAT_MODEL_PROFILE=default
# RESPONSE_MODEL_PROFILE=default

# --- Service implementations ---
# Precedence: CLI --service > environment > config/services.json > built-in defaults.
# Uncomment only the choices you want to override; keep secrets out of JSON.
# SERVICES_CONFIG=config/services.json
# Chat workflow registered in ServiceFactories; used by both FastAPI and CLI chat.
# CHAT_GRAPH_TYPE=recipe
# Implicit default profile provider: openai, anthropic, google_genai.
# Also set CHAT_MODEL to that provider's model ID. Named profiles select their own provider.
# CHAT_MODEL_TYPE=openai
# MESSAGE_ANALYZER_TYPE=llm
# RECIPE_SEARCH_TYPE=postgres
# RECIPE_GENERATION_TYPE=llm
# RECIPE_EXTRACTOR_TYPE=llm
# RECIPE_INGESTION_TYPE=postgres
# DIETITIAN_TYPE=file
# RECIPE_PRESENTATION_TYPE=structured

# --- Request admission ---
# In database mode the published release supplies this policy and history limits.
# API and CLI chat always check safety and scope before graph execution.
# Default: client-specific config/dietitians/<id>/guard.json, else config/guard.json.
# GUARD_CONFIG overrides both. Thresholds/replies/history bounds live in that JSON.
# The Decisions evaluator uses OPENAI_API_KEY even when chat uses another provider.
# REQUEST_VALIDATOR_TYPE / REQUEST_VALIDATOR_MODEL_PROFILE are legacy and unused.
# GUARD_CONFIG=config/guard.json

# --- Optional photo messages ---
# File mode uses config/image_recognition.json for the vision model and extraction prompt.
# Database mode snapshots image_recognition inside each published release.
# An absent image_recognition field preserves older releases as text-only.
# IMAGE_RECOGNITION_CONFIG=config/image_recognition.json

# --- API ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# --- Rate limits (requests per minute) ---
RATE_LIMIT_PER_USER=15
RATE_LIMIT_PER_IP=40

# --- Logging ---
LOG_LEVEL=INFO

# Set true when serving over HTTPS so the session cookie is never sent on HTTP
SESSION_COOKIE_SECURE=false
